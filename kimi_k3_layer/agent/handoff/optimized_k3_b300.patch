diff --git a/tensorrt_llm/_torch/kimi_k3_optim/capabilities.py b/tensorrt_llm/_torch/kimi_k3_optim/capabilities.py
new file mode 100644
index 0000000000..7bfedebef4
--- /dev/null
+++ b/tensorrt_llm/_torch/kimi_k3_optim/capabilities.py
@@ -0,0 +1,169 @@
+"""Per-stage kill switches for the B10 Kimi-K3 MoE layer.
+
+Every optimization this package adds can be switched OFF in production with an
+environment variable, no code change and no image rebuild -- because a tuned
+kernel that is wrong on some node must be a config rollback, not an incident.
+Three levels:
+
+* ``TRTLLM_KIMI_B10_MOE=0``  (modeling_kimi_k3.py) -- master switch, the stock
+  layer is used and nothing in this package runs.
+* ``KIMI_B10_DISABLE_STAGES=stage1,stage2`` -- switch off individual
+  optimizations; each ladder ends at a rung every part can run (reference
+  routing, packed tail, full fc1 ...), so the layer contract is unchanged.
+* ``KIMI_B10_COMM_NCCL_ONLY=1``  (communication/collectives.py) -- every
+  collective goes through NCCL: no symmetric-memory rendezvous, no CUDA-IPC,
+  no NVLS multimem. This is the switch the 2-node GB300 bring-up had to
+  hot-patch into ``available()`` by hand; NCCL is the one transport that
+  works across nodes over MNNVL (measured 657 GB/s busbw cross-node).
+
+Stage names (see ``filter`` for the exact ladders)::
+
+    fused_front_cute        decode front: fused CuTeDSL dual-out GEMM
+    radix_routing           SGLang RouteRadixKernel top-16
+    multimem_tail           decode tail: multimem full-fc2
+    sharded_fc2_tail        decode tail: sharded fc2 + output reduce
+    route_side_stream       routing kernel off the main stream
+    sharded_prefill_fc1     prefill fc1 column shard (+ col-AG gather)
+    fc2_shard_prefill_tail  prefill tail: fc2 shard
+    prefill_overlap         shared-branch overlap during prefill
+
+Decided ONCE at layer init, outside any timed or captured region, and
+**agreed across ranks** (all-reduce MIN over the flag bitmask): a stage that
+carries a collective must be on everywhere or nowhere, or ranks deadlock in
+mismatched collectives instead of failing loudly.
+
+Ported from LLMDiveDeep ``kimi_k3_layer/capabilities.py``; the expert-backend
+(native vs FlashInfer) decision is NOT a stage here because it must be made
+in ``__init__`` before weights load -- see the arch+SiTU gate in
+``moe_layer.py``.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass, replace
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:  # avoid a moe_layer import cycle
+    from .moe_layer import ExperimentConfig
+
+_DISABLE_ENV = "KIMI_B10_DISABLE_STAGES"
+
+_STAGES: tuple[str, ...] = (
+    "fused_front_cute",
+    "radix_routing",
+    "multimem_tail",
+    "sharded_fc2_tail",
+    "route_side_stream",
+    "sharded_prefill_fc1",
+    "fc2_shard_prefill_tail",
+    "prefill_overlap",
+)
+
+
+@dataclass(frozen=True)
+class Capabilities:
+    """One flag per gated stage. True = the fast implementation may run."""
+
+    fused_front_cute: bool = True
+    radix_routing: bool = True
+    multimem_tail: bool = True
+    sharded_fc2_tail: bool = True
+    route_side_stream: bool = True
+    sharded_prefill_fc1: bool = True
+    fc2_shard_prefill_tail: bool = True
+    prefill_overlap: bool = True
+
+    @classmethod
+    def probe(cls, group=None) -> "Capabilities":
+        disabled = {
+            name.strip()
+            for name in os.environ.get(_DISABLE_ENV, "").split(",")
+            if name.strip()
+        }
+        unknown = disabled.difference(_STAGES)
+        if unknown:
+            raise ValueError(
+                f"{_DISABLE_ENV} names unknown stage(s): {sorted(unknown)}; "
+                f"valid: {sorted(_STAGES)}")
+        caps = cls(**{stage: stage not in disabled for stage in _STAGES})
+        return caps._agree(group)
+
+    def _agree(self, group) -> "Capabilities":
+        """All-reduce MIN so every rank runs the same stages."""
+        import torch
+        import torch.distributed as dist
+
+        if group is None or not dist.is_available() \
+                or not dist.is_initialized():
+            return self
+        if dist.get_world_size(group) == 1:
+            return self
+        flags = torch.tensor(
+            [int(getattr(self, name)) for name in _STAGES],
+            dtype=torch.int32, device="cuda")
+        dist.all_reduce(flags, op=dist.ReduceOp.MIN, group=group)
+        return replace(self, **{
+            name: bool(value)
+            for name, value in zip(_STAGES, flags.tolist())})
+
+    def log_once(self, rank: int = 0) -> None:
+        if rank != 0:
+            return
+        off = [stage for stage in _STAGES if not getattr(self, stage)]
+        if not off:
+            print("[B10-KIMI-MOE] all optimization stages enabled",
+                  flush=True)
+            return
+        # Loud on purpose: "running degraded" must be visible in prod logs,
+        # not inferred from a latency regression.
+        print(f"[B10-KIMI-MOE] DEGRADED via {_DISABLE_ENV}: "
+              f"{len(off)} stage(s) off", flush=True)
+        for stage in off:
+            print(f"[B10-KIMI-MOE]   {stage}: disabled", flush=True)
+
+    def filter(self, config: "ExperimentConfig") -> "ExperimentConfig":
+        """Rewrite a plan so it only names enabled implementations.
+
+        Each ladder ends at a rung that needs no custom kernel and no
+        non-NCCL collective, so the result is always executable.
+        """
+        from .moe_layer import (
+            DecodeFront, DecodeTail, PrefillFC1, PrefillTail, Routing,
+        )
+
+        changes: dict[str, object] = {}
+        # front: fused CuTeDSL dual-out -> separate sharded fc1 -> full fc1
+        if (not self.fused_front_cute and config.decode_front
+                is DecodeFront.FUSED_FC1_SHARED_GATE_CUTE):
+            changes["decode_front"] = (
+                DecodeFront.SEPARATE_SHARDED_FC1 if self.sharded_prefill_fc1
+                else DecodeFront.SEPARATE_FULL_FC1)
+        # routing: radix kernel -> reference gate + top-k
+        if not self.radix_routing and config.routing is Routing.RADIX:
+            changes["routing"] = Routing.REFERENCE
+        # decode tail: multimem full-fc2 -> sharded fc2 -> packed latent
+        tail = config.decode_tail
+        if (not self.multimem_tail
+                and tail is DecodeTail.FULL_FC2_MULTIMEM_SHARED_REDUCE):
+            tail = (DecodeTail.SHARDED_FC2_OUTPUT_REDUCE
+                    if self.sharded_fc2_tail
+                    else DecodeTail.PACKED_LATENT_SHARED_REDUCE)
+        if (not self.sharded_fc2_tail
+                and tail is DecodeTail.SHARDED_FC2_OUTPUT_REDUCE):
+            tail = DecodeTail.PACKED_LATENT_SHARED_REDUCE
+        if tail is not config.decode_tail:
+            changes["decode_tail"] = tail
+        if not self.route_side_stream and config.route_on_side_stream:
+            changes["route_on_side_stream"] = False
+        # prefill fc1: sharded (+ col-AG gather) -> full
+        if (not self.sharded_prefill_fc1
+                and config.prefill_fc1 is PrefillFC1.SHARDED):
+            changes["prefill_fc1"] = PrefillFC1.FULL
+        # prefill tail: fc2 shard -> packed
+        if (not self.fc2_shard_prefill_tail
+                and config.prefill_tail is PrefillTail.FC2_SHARD):
+            changes["prefill_tail"] = PrefillTail.PACKED
+        if not self.prefill_overlap and config.prefill_overlap_shared_branch:
+            changes["prefill_overlap_shared_branch"] = False
+        return replace(config, **changes) if changes else config
