@@ -0,0 +1,79 @@
+"""Target-architecture helpers for every JIT compile site in this package.
+
+One place decides what the kernels are built for, so a checkout runs on the
+part it is actually executing on instead of the one it was written on. This
+mirrors LLMDiveDeep's ``common/arch.py``; it is duplicated here only because
+this package cannot import that repo.
+
+Why it matters, concretely -- two failure modes seen on GB300 (sm103):
+
+* ``--gpu-arch sm_100a`` / ``TVM_FFI_CUDA_ARCH_LIST="10.0a"`` build an
+  arch-specific cubin that LOADS on a 10.3 device and then dies at the first
+  launch with "no kernel image is available for execution on the device", i.e.
+  after warm-up, inside serving.
+* build caches keyed on name + source hash but NOT on arch silently hand a
+  B200 artifact to a B300. Every cache key here therefore carries ``tag()``.
+
+``B10_FORCE_SM=10.3`` overrides detection for exercising a target's flags on
+another host; it affects flags and cache naming only, never dispatch.
+"""
+
+from __future__ import annotations
+
+import os
+
+_FORCE_ENV = "B10_FORCE_SM"
+
+
+def sm_version() -> tuple[int, int]:
+    """(major, minor) of the target arch."""
+    forced = os.environ.get(_FORCE_ENV)
+    if forced:
+        major, _, minor = forced.partition(".")
+        return int(major), int(minor or 0)
+    import torch
+
+    return torch.cuda.get_device_capability()
+
+
+def suffix() -> str:
+    """nvcc/CuTeDSL arch suffix, e.g. ``'103a'``."""
+    major, minor = sm_version()
+    return f"{major}{minor}a"
+
+
+def tag() -> str:
+    """Short cache tag, e.g. ``'sm103a'``."""
+    return f"sm{suffix()}"
+
+
+def cuda_arch_macro() -> int:
+    """``__CUDA_ARCH__`` for the target: 1000 on sm_100a, 1030 on sm_103a."""
+    major, minor = sm_version()
+    return major * 100 + minor * 10
+
+
+def cutedsl_arch_option() -> str:
+    """``--gpu-arch`` fragment for ``cute.compile(..., options=...)``."""
+    return f"--gpu-arch sm_{suffix()}"
+
+
+def tvm_ffi_arch_list() -> str:
+    """``TVM_FFI_CUDA_ARCH_LIST`` value, e.g. ``'10.3a'``."""
+    major, minor = sm_version()
+    return f"{major}.{minor}a"
+
+
+def torch_arch_list() -> str:
+    """Value for ``TORCH_CUDA_ARCH_LIST`` (torch wants ``'10.3a'``)."""
+    major, minor = sm_version()
+    return f"{major}.{minor}a"
+
+
+def ext_name(base: str) -> str:
+    """Arch-qualified torch extension name.
+
+    ``torch.utils.cpp_extension`` keys its build dir on name + source hash,
+    NOT on arch -- an unqualified name replays one arch's cubin on another.
+    """
+    return f"{base}_{tag()}"
