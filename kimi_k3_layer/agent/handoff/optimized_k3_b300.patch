-_CUDA_FLAGS = ("-std=c++20", "-O3", "-DSGL_CUDA_ARCH=1000",
-               "--expt-relaxed-constexpr")
 _MODULE = None
 
 
+def _target() -> tuple[int, int]:
+    """(major, minor) of the device this build targets.
+
+    ``B10_FORCE_SM=10.3`` overrides it, to exercise a target's flags on
+    another host; it affects flags and cache naming only, never dispatch.
+    """
+    forced = os.environ.get("B10_FORCE_SM")
+    if forced:
+        major, _, minor = forced.partition(".")
+        return int(major), int(minor or 0)
+    return torch.cuda.get_device_capability()
+
+
+def _cuda_arch() -> int:
+    """``__CUDA_ARCH__`` for the target: 1000 on sm_100a, 1030 on sm_103a."""
+    major, minor = _target()
+    return major * 100 + minor * 10
+
+
+def _arch_list() -> str:
+    """``TVM_FFI_CUDA_ARCH_LIST`` value, e.g. ``'10.3a'``."""
+    major, minor = _target()
+    return f"{major}.{minor}a"
+
+
+def _arch_tag() -> str:
+    """Module/cache tag, e.g. ``'sm103a'``."""
+    return f"sm{_arch_list().replace('.', '')}"
+
+
+def _cuda_flags() -> tuple[str, ...]:
+    """Compile flags for the target arch.
+
+    ``SGL_CUDA_ARCH`` is load-bearing, not decoration:
+    ``include/sgl_kernel/utils.cuh:122`` asserts
+    ``__CUDA_ARCH__ == SGL_CUDA_ARCH``, so it must track the arch list -- a
+    mismatch is a compile error, which is the *good* failure. Getting both
+    wrong together is the bad one: a 10.0a cubin loads on a 10.3 device and
+    dies at the first launch with "no kernel image is available" (measured
+    on GB300), i.e. after warm-up, inside serving.
+
+    No fast-math: the artifact is ID-exact against the FP32 oracle and
+    sigmoid rounding must stay bit-for-bit unchanged.
+    """
+    return ("-std=c++20", "-O3", f"-DSGL_CUDA_ARCH={_cuda_arch()}",
+            "--expt-relaxed-constexpr")
+
+
 def _source_hash() -> str:
     digest = hashlib.sha256()
     for f in sorted(_PKG.rglob("*")):
         if f.is_file():
             digest.update(f.name.encode())
             digest.update(f.read_bytes())
-    digest.update(" ".join(_CUDA_FLAGS).encode())
+    digest.update(" ".join(_cuda_flags()).encode())
+    # Not implied by the flags, and the reason a flags-only key is unsafe:
+    # TVM_FFI_CUDA_ARCH_LIST selects the cubin, so two arches must never
+    # share a cache entry (a baked image or an NFS home would otherwise
+    # hand a B200 .so to a B300).
+    digest.update(_arch_list().encode())
     return digest.hexdigest()[:16]
 
 
